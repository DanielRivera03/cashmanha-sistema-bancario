# =====================================================================
# CashMan H.A. v2 — Plantilla de configuración
#
# 1) Copie este archivo a  ".env"
# 2) Rellene los valores marcados con << ... >>
#
# El ".env" real NUNCA se versiona (está en .gitignore). Si alguna de
# estas claves se filtra, hay que rotarlas TODAS.
#
# Genere cada clave de 32 bytes (base64) con:
#   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Y la semilla de auditoría (hex) con:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# =====================================================================

APP_NOMBRE="CashMan H.A."
APP_ENTORNO=local
APP_DEPURACION=false
# Ajuste la URL a dónde quede servido el directorio /public:
APP_URL=http://localhost/cashmanha-v2/public
APP_DOMINIO=localhost
APP_ZONA_HORARIA=America/El_Salvador

# --- Base de datos ----------------------------------------------------
# En producción, use un usuario SIN privilegios DROP/ALTER/FILE/GRANT.
DB_HOST=127.0.0.1
DB_PUERTO=3306
DB_NOMBRE=cashmanha_v2
DB_USUARIO=root
DB_CLAVE=
DB_CHARSET=utf8mb4

# --- Claves criptográficas (OBLIGATORIAS — genere las suyas) ----------
APP_CLAVE=<< base64 de 32 bytes >>
PASSWORD_PEPPER=<< base64 de 32 bytes >>
SESION_SAL=<< base64 de 32 bytes >>
TARJETA_CLAVE=<< base64 de 32 bytes >>
TARJETA_PEPPER=<< base64 de 32 bytes >>
AUDITORIA_SEMILLA=<< hex de 32 bytes >>

# --- Argon2id (hashing de contraseñas) --------------------------------
# memory_cost en KiB. 65536 = 64 MiB. Calibre con: php bin/calibrar-argon2.php
ARGON_MEMORY_COST=65536
ARGON_TIME_COST=4
ARGON_THREADS=2

# --- Sesión -----------------------------------------------------------
SESION_NOMBRE=__Host-cmsid
SESION_INACTIVIDAD_SEG=600
SESION_ABSOLUTA_SEG=28800
# true en producción con HTTPS; false en localhost sin TLS.
SESION_SEGURA=false

# --- Límites de tasa --------------------------------------------------
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_SEG=900
LOGIN_BLOQUEO_SEG=900
OTP_MAX_INTENTOS=3
OTP_VIGENCIA_SEG=300

# --- Correo (SMTP) ----------------------------------------------------
# En la DEMO los correos van APAGADOS (CORREO_HABILITADO=false): los
# códigos de verificación (OTP) aparecen en la CAMPANA de notificaciones
# dentro del sistema. Actívelo solo con su propio servidor SMTP.
CORREO_HABILITADO=false
SMTP_HOST=smtp.ejemplo.com
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_CIFRADO=tls
SMTP_DESDE=no-responder@ejemplo.com
SMTP_DESDE_NOMBRE="CashMan H.A."

# --- Pasarela de pago -------------------------------------------------
# "simulada": emisión propia, SIN dependencias externas (recomendada para probar).
# "stripe":   claves de PRUEBA en https://dashboard.stripe.com/test/apikeys
PASARELA=simulada
STRIPE_CLAVE_PUBLICA=
STRIPE_CLAVE_SECRETA=
STRIPE_WEBHOOK_SECRETO=

# --- Clima (opcional, OpenWeatherMap) ---------------------------------
# Clave gratuita en https://openweathermap.org/api . Si lo deja apagado,
# el sistema funciona igual (solo no muestra el clima).
CLIMA_HABILITADO=false
CLIMA_API_KEY=
CLIMA_CIUDAD_ID=3583361
CLIMA_CIUDAD_NOMBRE="San Salvador"

# --- Tiempo real (SSE) ------------------------------------------------
SSE_HABILITADO=true
SSE_INTERVALO_MS=2000
SSE_TIMEOUT_SEG=45
